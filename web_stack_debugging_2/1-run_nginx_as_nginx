#!/usr/bin/env bash
# Configure Nginx to run as nginx user and listen on port 8080
useradd --system --no-create-home --shell /bin/false nginx 2>/dev/null || true
sed -i 's/^user www-data;/user nginx;/' /etc/nginx/nginx.conf
sed -i 's/listen 80 default_server/listen 8080 default_server/g' /etc/nginx/sites-enabled/default
sed -i 's/listen \[::\]:80 default_server/listen [::]:8080 default_server/g' /etc/nginx/sites-enabled/default
sed -i 's/listen 80;/listen 8080;/g' /etc/nginx/sites-enabled/default
sed -i 's/listen \[::\]:80;/listen [::]:8080;/g' /etc/nginx/sites-enabled/default
pkill nginx || true
chown -R nginx:nginx /var/log/nginx
chown -R nginx:nginx /var/lib/nginx
touch /run/nginx.pid
chown nginx:nginx /run/nginx.pid
su -s /bin/bash nginx -c "nginx -g 'daemon off;'" &
sleep 1
