#!/usr/bin/env bash
# Configures Nginx to redirect /redirect_me permanently to a specified URL

# Install nginx if not installed
apt-get update -y
apt-get install -y nginx

# Backup default site config
cp /etc/nginx/sites-enabled/default /etc/nginx/sites-enabled/default.bak

# Add redirection for /redirect_me
sed -i '/server_name _;/a \ \ location /redirect_me {\n\ \ \ \ return 301 https://www.youtube.com/watch?v=QH2-TGUlwu4;\n\ \ }' /etc/nginx/sites-enabled/default

# Test nginx configuration
nginx -t

# Reload nginx to apply changes
service nginx restart