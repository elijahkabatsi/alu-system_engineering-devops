#!/usr/bin/env bash
# Installs and configures HAProxy to load balance two web servers

# Update and install HAProxy
sudo apt-get update -y
sudo apt-get install haproxy -y

# Backup existing HAProxy config
sudo cp /etc/haproxy/haproxy.cfg /etc/haproxy/haproxy.cfg.bak

# Overwrite HAProxy configuration
sudo tee /etc/haproxy/haproxy.cfg > /dev/null <<'EOF'
global
    log /dev/log    local0
    log /dev/log    local1 notice
    daemon

defaults
    log     global
    mode    http
    option  httplog
    option  dontlognull
    timeout connect 5000
    timeout client  50000
    timeout server  50000

frontend http_front
    bind *:80
    default_backend http_back

backend http_back
    balance roundrobin
    server web-01 3.89.31.111:80 check
    server web-02 44.202.5.108:80 check
EOF

# Restart HAProxy to apply configuration
sudo systemctl restart haproxy

# Optional: check HAProxy config
sudo haproxy -c -f /etc/haproxy/haproxy.cfg